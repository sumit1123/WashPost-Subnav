<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/paywall_margin_small"
    android:clipToPadding="false"
    android:clipChildren="false"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/billing_selector_box_normal"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/savings_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/savings_pill_style"
        app:layout_constraintTop_toTopOf="@id/main_container"
        app:layout_constraintBottom_toTopOf="@id/main_container"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginRight="@dimen/paywall_margin"
        android:background="@drawable/savings_pill_background"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:text="SAVINGS 22%"
        />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginLeft="@dimen/paywall_margin"
        android:layout_marginTop="@dimen/paywall_margin_medium"
        android:layout_marginBottom="@dimen/paywall_margin_medium"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/billing_period_label"
            style="@style/billing_period_label_style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yearly"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/primary_offer_text"
            style="@style/intro_offer_text_style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Try 1 year for $29.99"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/secondary_offer_text"
            style="@style/regular_offer_text_style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="then $99.99/year"
            />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/check_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginRight="@dimen/paywall_margin"
        app:srcCompat="@drawable/check_unselected"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/check_circle_selected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginRight="@dimen/paywall_margin"
        android:scaleX="0"
        android:scaleY="0"
        app:srcCompat="@drawable/check_selected"/>

</androidx.constraintlayout.widget.ConstraintLayout>