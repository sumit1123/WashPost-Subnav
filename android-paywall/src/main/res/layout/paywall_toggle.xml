<?xml version="1.0" encoding="utf-8"?>

<com.washingtonpost.android.paywall.bottomsheet.ui.MultilineMaterialButtonToggleGroup
xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
android:id="@+id/period_toggle"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_gravity="center_horizontal"
android:gravity="center"
app:checkedButton="@id/monthly"
app:selectionRequired="true"
app:singleSelection="true">

<com.google.android.material.button.MaterialButton
    android:id="@+id/option_a"
    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="5dp"
    android:layout_weight="1"
    android:text="@string/monthly"
    android:textAllCaps="false"
    app:backgroundTint="@color/toggle_button_states"
    app:shapeAppearance="@style/rounded"
    app:strokeColor="@color/toggle_group_color"
    app:strokeWidth="4dp" />

<com.google.android.material.button.MaterialButton
    android:id="@+id/option_b"
    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="5dp"
    android:layout_weight="1"
    android:text="@string/yearly"
    android:textAllCaps="false"
    app:backgroundTint="@color/toggle_button_states"
    app:shapeAppearance="@style/rounded"
    app:strokeColor="@color/toggle_group_color"
    app:strokeWidth="4dp" />
</com.washingtonpost.android.paywall.bottomsheet.ui.MultilineMaterialButtonToggleGroup>