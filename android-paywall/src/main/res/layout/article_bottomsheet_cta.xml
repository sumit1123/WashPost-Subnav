<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/paywall_container"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical">

    <TextView
        android:id="@+id/gift_cta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/gift_cta_text_style"
        app:layout_constraintTop_toTopOf="parent"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/paywall_margin"
        android:paddingEnd="@dimen/paywall_margin"
        android:paddingTop="@dimen/paywall_margin_large"
        android:paddingBottom="@dimen/paywall_margin_large"
        android:text="@string/valid_gift_cta" />
</androidx.constraintlayout.widget.ConstraintLayout>