<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bottom_sheet_background">

    <ImageView
        android:id="@+id/logo"
        style="@style/accountHoldLogo"
        android:layout_marginLeft="@dimen/reminder_vertical_margin_x_large"
        android:layout_marginRight="@dimen/reminder_vertical_margin_x_large"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <ImageView
        android:id="@+id/accountHoldClose"
        style="@style/accountHoldClose"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@id/logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/logo"
        tools:layout_editor_absoluteX="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/accounthold_vertical_margin_top"
            android:layout_marginBottom="@dimen/accounthold_vertical_margin_bottom"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="8dp"
                android:src="@drawable/account_hold1"/>

            <TextView
                android:id="@+id/header"
                style="@style/accounthold_text_h1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/accounthold_header" />

            <TextView
                android:id="@+id/accounthold_text_h2"
                style="@style/accounthold_text_h2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/accounthold_update" />


            <Button
                android:id="@+id/btnUpdatePayment"
                style="@style/accounthold_button"
                android:layout_gravity="center"
                android:background="@drawable/accounthold_button_background"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="Update payment details" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/subscription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp">

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight=".5"
                android:background="@drawable/accounthold_line_shape" />

            <TextView
                style="@style/accounthold_subscription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_weight=".55"
                android:gravity="center"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:text="Your subscription "
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight=".5"
                android:background="@drawable/accounthold_line_shape" />


        </LinearLayout>

        <TextView
            android:id="@+id/core"
            style="@style/accounthold_core"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/core" />

        <TextView
            android:id="@+id/account_hold_price"
            style="@style/accounhold_sub_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="$9.99/month"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="@dimen/accounthold_vertical_margin"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:adjustViewBounds="true"
                android:padding="3dp"
                android:src="@drawable/check_green" />

            <TextView
                style="@style/accounhold_sub_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingLeft="3dp"
                android:text="Unlimited access in our apps and on the web." />
        </LinearLayout>

        <TextView
            android:id="@+id/account_contact_us"
            style="@style/accounhold_contact_us"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/contact_us" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>