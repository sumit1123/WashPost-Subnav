<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:id="@+id/full_sign_in_text"
        style="@style/paywall_sheet_sub_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fine_print_margin"
        android:layout_marginBottom="@dimen/fine_print_margin"
        android:background="@color/transparent"
        android:textColorLink="@color/black"
        android:layout_gravity="center"
        android:gravity="center"/>

    <TextView
        android:id="@+id/fine_print_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        style="@style/paywall_sheet_fine_print"
        android:text="@string/tos_pp_fine_print"
        />
</LinearLayout>