<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="#CC000000"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@id/exo_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@id/exo_mute"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="20"
            android:background="@drawable/color_transparent"
            android:padding="@dimen/exo_icon_padding"
            android:visibility="gone"
            android:contentDescription="Mute"
            android:src="@drawable/ic_baseline_volume_mute_24" />

        <ImageButton
            android:id="@id/exo_unmute"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="20"
            android:background="@drawable/color_transparent"
            android:padding="@dimen/exo_icon_padding"
            android:contentDescription="Unmute"
            android:src="@drawable/ic_baseline_volume_up_24" />

        <ImageButton
            android:id="@id/exo_play_pause"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            style="@style/ExoStyledControls.Button.Center.PlayPause"
            android:layout_gravity="center_vertical" />

        <ImageButton
            android:id="@id/exo_share"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="20"
            android:background="@drawable/color_transparent"
            android:foregroundGravity="right"
            android:padding="@dimen/exo_icon_padding"
            android:contentDescription="Share"
            android:src="@drawable/ic_baseline_share_24" />

        <ImageButton
            android:id="@id/exo_cc"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="20"
            android:background="@drawable/color_transparent"
            android:foregroundGravity="right"
            android:padding="@dimen/exo_icon_padding"
            android:contentDescription="Closed captions"
            android:src="@drawable/ic_baseline_closed_caption_24" />

        <ImageButton
            android:id="@id/exo_pip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="20"
            android:background="@drawable/color_transparent"
            android:foregroundGravity="right"
            android:padding="@dimen/exo_icon_padding"
            android:contentDescription="Picture in Picture"
            android:src="@drawable/ic_baseline_picture_in_picture_alt_24" />

        <ImageButton
            android:id="@id/exo_fullscreen"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="20"
            android:background="@drawable/color_transparent"
            android:foregroundGravity="right"
            android:padding="@dimen/exo_icon_padding"
            android:contentDescription="Full screen"
            android:src="@drawable/ic_baseline_fullscreen_24" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/exo_controls">

        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:textColor="#FFBEBEBE"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1" />

        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:textColor="#FFBEBEBE"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>