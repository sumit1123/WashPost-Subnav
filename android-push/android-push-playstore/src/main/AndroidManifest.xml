<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="com.urbanairship.push.fcm, com.urbanairship, com.urbanairship.android.layout, com.google.firebase.messaging" />

    <application>
        <service
            android:name="com.wapo.android.push.FCMPushNotificationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
