<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/bottomSheetStyleWrapper</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="bottomSheetStyleWrapper" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="feedback_title">
        <item name="android:fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="android:textColor">@color/feedback_title</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="feedback_description" parent="@style/feedback_title">
        <item name="android:textColor">@color/feedback_description</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
    </style>


    <style name="feedback_face" parent="@style/feedback_description"></style>

    <style name="feedback_details_title" parent="@style/feedback_title">
        <item name="android:textColor">@color/feedback_details_title</item>
    </style>

    <style name="feedback_details_description" parent="@style/feedback_details_title">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="feedback_input_box">
        <item name="android:fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="android:background">@drawable/feedback_input_box_border</item>
        <item name="android:textColorHint">@color/feedback_details_input_box_hint</item>
        <item name="android:textColor">@color/feedback_details_title</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="feedback_details_submit">
        <item name="android:fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/feedback_submit_button_shape</item>
        <item name="android:textColor">@color/feedback_details_submit_text</item>
    </style>
</resources>