<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="start"
    android:orientation="horizontal">

    <ImageView
        android:id="@id/exo_play"
        android:layout_width="@dimen/podcast_sf_play_button_size"
        android:layout_height="@dimen/podcast_sf_play_button_size"
        android:layout_gravity="center_vertical"
        android:background="#0000"
        android:src="@drawable/podcast_btn_play" />

    <ImageView
        android:id="@id/exo_pause"
        android:layout_width="@dimen/podcast_sf_pause_button_size"
        android:layout_height="@dimen/podcast_sf_pause_button_size"
        android:layout_gravity="center_vertical"
        android:background="#0000"
        android:layout_toEndOf="@+id/exo_play"
        android:src="@drawable/podcast_btn_pause" />

    <ProgressBar
        android:id="@+id/loadingSpinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@color/transparent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/player_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:layout_marginRight="8dp"
        android:text="@string/listen"
        android:layout_toEndOf="@+id/exo_pause"
        android:layout_centerVertical="true"
        android:textColor="@color/podcast_text_color" />

    <TextView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/player_status"
        android:textColor="@color/podcast_text_color" />

</RelativeLayout>
