<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/ll_podcast_timer"
        app:bar_height="@dimen/podcast_time_bar_height"
        app:played_color="@color/shimmer_background_color"
        app:scrubber_drawable="@drawable/podcast_scrubber" />

    <LinearLayout
        android:id="@id/ll_podcast_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/ll_podcast_player_buttons"
        android:layout_marginLeft="@dimen/podcast_timer_position_margin"
        android:layout_marginRight="@dimen/podcast_timer_position_margin"
        android:layout_marginBottom="@dimen/podcast_play_button_vertical_margin"
        android:orientation="horizontal">

        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:background="@color/shimmer_background_color"
            android:textSize="@dimen/podcast_timer_text_size"
            android:textColor="@color/shimmer_background_color"
            android:text="0:00"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/shimmer_background_color"
            android:textColor="@color/shimmer_background_color"
            android:text="0:00"
            android:includeFontPadding="false"
            android:textSize="@dimen/podcast_timer_text_size" />
    </LinearLayout>

    <LinearLayout
        android:id="@id/ll_podcast_player_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:orientation="horizontal">

        <ImageButton
            android:id="@id/exo_rew"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:src="@drawable/placeholder_circular_button"
            android:background="@color/transparent" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@id/exo_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/podcast_play_button_horizontal_margin"
                android:layout_marginRight="@dimen/podcast_play_button_horizontal_margin"
                android:src="@drawable/placeholder_circular_button"
                android:background="@color/transparent" />

            <ImageButton
                android:id="@id/exo_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/podcast_play_button_horizontal_margin"
                android:layout_marginRight="@dimen/podcast_play_button_horizontal_margin"
                android:src="@drawable/placeholder_circular_button"
                android:background="@color/transparent"/>
        </FrameLayout>

        <ImageButton
            android:id="@id/exo_ffwd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:src="@drawable/placeholder_circular_button"
            android:background="@color/transparent" />
    </LinearLayout>
</RelativeLayout>