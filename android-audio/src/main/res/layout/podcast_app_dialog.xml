<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/podcast_dialog_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:background="@color/transparent"
    android:orientation="vertical"
    android:paddingTop="@dimen/podcast_vertical_margin_medium"
    android:paddingBottom="@dimen/podcast_vertical_margin_medium">

    <TextView
        android:id="@+id/tv_podcast_app_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/podcast_app_dialog_margin_medium"
        android:background="@color/transparent"
        android:paddingLeft="@dimen/podcast_app_dialog_margin_medium"
        android:paddingRight="@dimen/podcast_app_dialog_margin_medium"
        android:textColor="@color/podcast_dialog_title_color"
        android:textSize="@dimen/podcast_title_text_size"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#e9e9e9" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_podcast_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent"
        android:overScrollMode="never" />
</LinearLayout>