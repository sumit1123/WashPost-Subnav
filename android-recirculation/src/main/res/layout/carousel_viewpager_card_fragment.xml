<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:id="@+id/ll_root_layout">

    <androidx.cardview.widget.CardView
        xmlns:card_view="http://schemas.android.com/apk/res-auto"
        android:id="@+id/cv_card_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        card_view:cardCornerRadius="@dimen/carousel_card_corner_radius"
        card_view:cardUseCompatPadding="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:layout_alignParentTop="true"
                android:layout_above="@+id/tv_article_title"/>

            <TextView
                android:id="@id/tv_article_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:textColor="@color/carousel_title_text_color"
                android:textSize="@dimen/carousel_title_font_size"
                android:visibility="gone"
                android:layout_marginTop="@dimen/carousel_card_text_margin"
                android:layout_marginLeft="@dimen/carousel_card_text_margin"
                android:layout_marginRight="@dimen/carousel_card_text_margin"
                android:layout_above="@+id/tv_byline" />

            <TextView
                android:id="@id/tv_byline"
                android:layout_alignParentBottom="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textSize="@dimen/carousel_byline_font_size"
                android:textColor="@color/carousel_title_text_color"
                android:layout_margin="@dimen/carousel_card_text_margin"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>