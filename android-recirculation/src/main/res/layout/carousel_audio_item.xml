<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audio_item_card"
    android:layout_width="@dimen/carousel_audio_card_width"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/carousel_audio_card_vertical_margin"
    android:layout_marginBottom="@dimen/carousel_audio_card_vertical_margin"
    app:rippleColor="@color/transparent"
    android:background="@color/transparent"
    app:cardCornerRadius="@dimen/carousel_immersion_card_radius">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/audio_item_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/item_art_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/item_art"
                android:layout_width="match_parent"
                android:layout_height="@dimen/carousel_audio_card_image_height"
                android:scaleType="centerCrop"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:contentDescription="@string/audio_item_art" />

            <LinearLayout
                android:id="@+id/item_overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:background="#CC111111"
                android:orientation="horizontal">

                <com.washingtonpost.android.follow.ui.CircleImageView
                    android:id="@+id/prefix_media_overlay"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="17dp"
                    android:layout_gravity="center"/>

                <TextView
                    android:id="@+id/text_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/audio_carousel_overlay_text"
                    android:layout_gravity="center"
                    android:layout_marginStart="8dp"
                    android:layout_marginVertical="8dp"
                    android:layout_marginEnd="17dp"/>

            </LinearLayout>

        </FrameLayout>


        <TextView
            android:id="@+id/item_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/audio_carousel_item_headline"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/item_art_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/item_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/item_headline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <include
            android:id="@+id/carousel_audio_item_player_status"
            layout="@layout/carousel_audio_item_player_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"

            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/item_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="1" />

        <ImageButton
            android:id="@+id/ellipsis_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            android:background="@null"
            android:rotation="90"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ic_utility_menu"
            android:contentDescription="Utility menu dots" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>