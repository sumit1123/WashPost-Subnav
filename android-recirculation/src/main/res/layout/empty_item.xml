<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/audio_item_card"
    android:layout_width="@dimen/carousel_audio_card_width"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/carousel_audio_card_vertical_margin"
    android:layout_marginBottom="@dimen/carousel_audio_card_vertical_margin"
    android:background="@color/transparent"
    app:cardCornerRadius="4dp"
    app:rippleColor="@color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/image"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="62dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/wp_franklinitcstd_font_family"
            android:textColor="@color/carousel_empty_card_text1"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="No saved audio" />

        <TextView
            android:id="@+id/text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="97dp"
            android:fontFamily="@font/wp_franklinitcstd_font_family"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/carousel_empty_card_text2"
            android:textSize="14sp"
            tools:text="Use the Add to playlist icon to save audio articles to listen later." />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>