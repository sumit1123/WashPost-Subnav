<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="foryou_card_headline">
        <item name="android:fontFamily">@font/wp_postoniwide_font_family</item>
        <item name="fontFamily">@font/wp_postoniwide_font_family</item>
        <item name="android:textColor">@color/foryou_card_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="foryou_card_byline">
        <item name="android:fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="android:textColor">@color/foryou_card_byline</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="foryou_card_blurb">
        <item name="android:fontFamily">@font/wp_georgia_font_family</item>
        <item name="fontFamily">@font/wp_georgia_font_family</item>
        <item name="android:textColor">@color/foryou_card_blurb</item>
        <item name="android:ellipsize">end</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:maxLines">3</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="foryou_card_section">
        <item name="android:fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/foryou_card_section</item>
        <item name="android:textSize">14sp</item>
    </style>



</resources>