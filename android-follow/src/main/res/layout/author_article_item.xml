<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.2"
        android:text="The Nationals might not have finished the fight, but at least they started it"
        android:textColor="@color/my_post_headline"
        android:textSize="16sp"
        app:fontFamily="@font/wp_franklinitcstd_font_family" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/headline"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:text="By Jennifer Rubin"
        android:textColor="@color/my_post_signature"
        android:textSize="12sp"
        app:fontFamily="@font/wp_franklinitcstd_font_family" />

    <ImageButton
        android:id="@+id/ib_utility_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/headline"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="6dp"
        android:rotation="90"
        android:background="@null"
        app:srcCompat="@drawable/ic_more_horiz_black_24dp" />

</RelativeLayout>