<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/author_bottom_sheet"
    style="@style/author_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
    tools:context="com.washingtonpost.android.follow.fragment.AuthorBottomSheetDialogFragment">

    <com.washingtonpost.android.follow.ui.CircleImageView
        android:id="@+id/author_image"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:adjustViewBounds="true"
        android:src="@drawable/author_placeholder"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/author_name"
        style="@style/author_bottom_sheet_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/author_image" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/author_bio"
        style="@style/author_bottom_sheet_bio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/author_name" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/author_follow_button"
        style="@style/author_bottom_sheet_button"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="10dp"
        android:drawablePadding="@dimen/follow_btn_drawable_padding"
        android:paddingLeft="@dimen/follow_btn_padding"
        android:paddingRight="@dimen/follow_btn_padding"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/author_bio" />

</androidx.constraintlayout.widget.ConstraintLayout>