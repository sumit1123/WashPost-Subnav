<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="36dp">

    <com.google.android.material.chip.Chip
        android:id="@+id/button_footer"
        style="@style/MyPost.Action.Chip.Light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/my_post_card_content_left_margin"
        android:layout_marginEnd="@dimen/my_post_card_content_left_margin"
        android:text="@string/my_archive"
        android:textAppearance="@style/MyPost.Action.Chip.Light.Text"
        app:chipStrokeColor="@color/my_post_footer_chip_stoke_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>