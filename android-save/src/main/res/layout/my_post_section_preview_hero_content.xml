<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_preview_hero_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_hero_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/my_post_card_hero_content_left_margin"
        android:textColor="@color/my_post_section"
        android:textSize="@dimen/my_post_preview_section_text_size"
        android:textStyle="bold"
        app:fontFamily="@font/wp_franklinitcstd_font_family"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_hero_transparency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="@dimen/my_post_card_content_left_margin"
        android:textColor="@color/my_post_section"
        android:textSize="@dimen/my_post_preview_section_text_size"
        app:fontFamily="@font/wp_franklinitcstd_font_family"
        app:layout_constraintBottom_toBottomOf="@id/tv_hero_section"
        app:layout_constraintStart_toEndOf="@id/tv_hero_section"
        app:layout_constraintTop_toTopOf="@+id/tv_hero_section" />

    <TextView
        android:id="@+id/tv_hero_headline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/my_post_card_hero_content_left_margin"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/my_post_card_content_left_margin"
        android:lineSpacingMultiplier="1"
        android:textColor="@color/my_post_headline"
        android:textSize="@dimen/my_post_preview_headline_text_size"
        android:textStyle="bold"
        app:fontFamily="@font/wp_postoniwide_font_family"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_hero_section"
        app:layout_goneMarginTop="0dp" />

    <TextView
        android:id="@+id/tv_hero_blurb"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/my_post_card_hero_content_left_margin"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/my_post_card_content_left_margin"
        android:lineSpacingMultiplier="1.2"
        android:textColor="@color/my_post_byline"
        android:textSize="@dimen/my_post_preview_byline_text_size"
        android:visibility="@integer/my_post_blurb_visibility"
        app:fontFamily="@font/wp_franklinitcstd_font_family"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_hero_headline" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/headline_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_hero_headline, tv_hero_blurb" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_signature_date_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/my_post_card_hero_content_left_margin"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@+id/audioImageButton"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headline_barrier">

        <TextView
            android:id="@+id/tv_hero_signature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.25"
            android:paddingTop="@dimen/my_post_clickable_icons_padding"
            android:paddingBottom="@dimen/my_post_clickable_icons_padding"
            android:textColor="@color/my_post_signature"
            android:textSize="@dimen/my_post_preview_signature_text_size"
            app:fontFamily="@font/wp_franklinitcstd_font_family"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/percentConsumedTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="45% Completed"
            android:textColor="@color/my_post_signature"
            android:textSize="@dimen/my_post_preview_signature_text_size"
            android:visibility="gone"
            app:fontFamily="@font/wp_franklinitcstd_font_family"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_hero_signature"
            app:layout_goneMarginTop="12dp" />

        <TextView
            android:id="@+id/tv_hero_purchase_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/my_post_signature"
            android:textSize="@dimen/my_post_preview_signature_text_size"
            app:fontFamily="@font/wp_franklinitcstd_font_family"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_hero_signature" />

        <ImageButton
            android:id="@+id/ib_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:padding="@dimen/my_post_clickable_icons_padding"
            android:paddingStart="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_article_save_filled_16dp" />

        <TextView
            android:id="@+id/tv_date_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:lineSpacingMultiplier="1.25"
            android:paddingTop="@dimen/my_post_clickable_icons_padding"
            android:paddingBottom="@dimen/my_post_clickable_icons_padding"
            android:textColor="@color/my_post_signature"
            android:textSize="@dimen/my_post_preview_signature_text_size"
            app:fontFamily="@font/wp_franklinitcstd_font_family"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ib_save"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="0dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageButton
        android:id="@+id/audioImageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null"
        android:paddingStart="@dimen/my_post_clickable_icons_padding"
        android:paddingTop="@dimen/my_post_clickable_icons_padding"
        android:paddingBottom="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ib_utility_menu"
        app:layout_constraintTop_toBottomOf="@id/headline_barrier"
        app:layout_constraintVertical_bias="1.0"
        app:layout_goneMarginEnd="16dp"
        app:srcCompat="@drawable/ic_listen" />

    <ImageButton
        android:id="@+id/ib_utility_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null"
        android:paddingStart="@dimen/my_post_clickable_icons_padding"
        android:paddingTop="@dimen/my_post_clickable_icons_padding"
        android:paddingEnd="@dimen/my_post_clickable_icons_padding"
        android:paddingBottom="9dp"
        android:rotation="90"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headline_barrier"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/ic_utility_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>