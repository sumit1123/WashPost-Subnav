<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/my_post_dialog_bg"
    android:paddingBottom="32dp">

    <View
        android:id="@+id/view_top_bar"
        android:layout_width="48dp"
        android:layout_height="@dimen/dialog_top_bar_height"
        android:layout_marginTop="@dimen/podcast_vertical_margin_medium"
        android:background="@drawable/dialog_top_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/view_top_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_add_to_saved_stories"
                style="@style/MyPost.Utility.Menu.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_article_save_16dp"
                android:text="Add to saved stories"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_remove_from_saved_stories"
                style="@style/MyPost.Utility.Menu.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_trash"
                android:text="Remove from saved stories"
                app:layout_constraintTop_toBottomOf="@id/button_add_to_saved_stories" />

<!--            <androidx.appcompat.widget.AppCompatButton-->
<!--                android:id="@+id/button_remove_from_history"-->
<!--                style="@style/MyPost.Utility.Menu.Item"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                app:drawableStartCompat="@drawable/ic_trash"-->
<!--                android:text="Remove from reading history"-->
<!--                app:layout_constraintTop_toBottomOf="@+id/button_remove_from_saved_stories" />-->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_share"
                style="@style/MyPost.Utility.Menu.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/icon_share"
                android:text="Share"
                app:layout_constraintTop_toBottomOf="@+id/button_remove_from_saved_stories" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
