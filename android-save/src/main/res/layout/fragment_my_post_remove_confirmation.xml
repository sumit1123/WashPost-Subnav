<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/my_post_dialog_bg"
    android:padding="16dp">

    <View
        android:id="@+id/view_top_bar"
        android:layout_width="48dp"
        android:layout_height="@dimen/dialog_top_bar_height"
        android:background="@drawable/dialog_top_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_remove_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_top_bar"
        app:srcCompat="@drawable/ic_confirm_remove" />

    <TextView
        android:id="@+id/tv_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/wp_postoniwide_font_family"
        android:gravity="center"
        android:text="Remove from saved stories?"
        android:textColor="@color/my_post_dialog_label"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_remove_icon" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tv_label">

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/buttons_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="left"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent" />

        <com.google.android.material.chip.Chip
            android:id="@+id/button_cancel"
            style="@style/MyPost.Action.Chip.Light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="Cancel"
            android:textAppearance="@style/MyPost.Action.Chip.Light.Text"
            app:layout_constraintEnd_toStartOf="@id/buttons_barrier" />

        <com.google.android.material.chip.Chip
            android:id="@+id/button_confirm"
            style="@style/MyPost.Action.Chip.Dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Confirm"
            android:textAppearance="@style/MyPost.Action.Chip.Dark.Text"
            app:layout_constraintStart_toEndOf="@id/buttons_barrier" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/view_margin"
        android:layout_width="wrap_content"
        android:layout_height="1dp"
        android:layout_marginTop="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_buttons" />

</androidx.constraintlayout.widget.ConstraintLayout>
