<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!--
        To fix interstitial ads crash in landscape mode in Android 8:
        Error:
        java.lang.RuntimeException: Unable to start activity ComponentInfo{com.raycom.waff/com.google.android.gms.ads.AdActivity}:
        java.lang.IllegalStateException: Only fullscreen activities can request orientation
        References:
        https://groups.google.com/forum/#!msg/google-admob-ads-sdk/xQ4rql_jexc/28inSHeZAgAJ
        https://groups.google.com/forum/#!topic/google-admob-ads-sdk/8zPchu8c0Ko
        -->
        <activity
            android:name="com.google.android.gms.ads.AdActivity"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            tools:replace="android:theme" />

    </application>

</manifest>
