<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:a="http://schemas.android.com/apk/res/android"
    a:layout_width="match_parent"
    a:background="@color/font_size_dialog_background_color"
    a:layout_height="wrap_content">

    <TextView
        a:padding="20dp"
        a:id="@+id/dialog_title"
        style="@android:style/TextAppearance.Large"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_alignParentLeft="true"
        a:layout_alignParentStart="true"
        a:text="@string/font_size_dialog_title"
        a:textColor="@color/dialog_title_color" />

    <ListView
        a:id="@+id/list"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_below="@id/dialog_title" />

</RelativeLayout>