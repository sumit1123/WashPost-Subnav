<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_banner"
        android:paddingTop="@dimen/subscribe_banner_padding_vertical"
        android:paddingBottom="@dimen/subscribe_banner_padding_vertical"
        android:paddingLeft="@dimen/subscribe_banner_padding_horizontal"
        android:paddingRight="@dimen/subscribe_banner_padding_horizontal"
        android:layout_marginBottom="1dp"
        android:background="@color/subscribe_banner_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/close_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/subscribe_banner_bg"
            android:contentDescription="@string/close"
            android:paddingStart="16dp"
            android:paddingEnd="-4dp"
            android:src="@drawable/close_icon"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/main_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="30dp"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:gravity="center"
            app:layout_constraintWidth_percent="0.3"
            android:background="@drawable/button_rounded_blue"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintRight_toLeftOf="@id/close_button"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="Resubscribe for $2.99" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/primary_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/main_button"
            android:layout_marginEnd="16dp"
            style="@style/SubscribeBannerMainText"
            tools:text="Free preview ends soon — don't lose your unlimited access"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/secondary_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/subscribe_banner_margin"
            app:layout_constraintTop_toBottomOf="@id/primary_text"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/main_button"
            android:layout_marginEnd="16dp"
            style="@style/SubscribeBannerSecondaryText"
            app:layout_constraintVertical_bias="0.0"
            tools:text="Subscribe and never miss a story."
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>