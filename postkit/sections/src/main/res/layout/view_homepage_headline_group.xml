<?xml version="1.0" encoding="utf-8"?>

<merge xmlns:a="http://schemas.android.com/apk/res/android"
    a:layout_width="match_parent"
    a:layout_height="match_parent">

    <com.wapo.flagship.features.pagebuilder.CellHeadlineView
        a:id="@+id/headline"
        style="?attr/homepage_story_headline_cell_style"
        a:layout_width="match_parent"
        a:layout_height="wrap_content" />


    <com.wapo.view.FlowableTextView
        a:id="@+id/deck"
        style="?attr/homepage_story_blurb_cell_style"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginTop="@dimen/cell_homepagesotry_vert_spacing" />

</merge>