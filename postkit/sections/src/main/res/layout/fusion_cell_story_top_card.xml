<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:tag="material_card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/grid_top_card">

        <com.wapo.flagship.features.grid.HomepageStoryView2 xmlns:a="http://schemas.android.com/apk/res/android"
            a:id="@+id/story_view"
            style="?attr/homepage_story_grid_cell_card_style_no_bleed"
            a:layout_width="match_parent"
            a:layout_height="wrap_content">
        </com.wapo.flagship.features.grid.HomepageStoryView2>

    </com.google.android.material.card.MaterialCardView>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/newsprint_this_is_you_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>