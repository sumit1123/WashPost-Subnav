<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/subscribe_banner_padding_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/main_banner"
        android:paddingTop="@dimen/subscribe_banner_padding_vertical"
        android:paddingBottom="@dimen/subscribe_banner_padding_vertical"
        android:paddingLeft="@dimen/subscribe_banner_padding_horizontal"
        android:paddingRight="@dimen/subscribe_banner_padding_horizontal"
        android:gravity="center"
        android:layout_marginBottom="1dp"
        android:background="@color/subscribe_banner_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/SubscribeBannerMainText"
            tools:text="You're Previewing the Post"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/secondary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            style="@style/SubscribeBannerSecondaryText"
            tools:text="Already a Subscriber? Sign In"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/main_button"
            style="@style/SubscribeBannerButtonText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:background="@drawable/button_rounded_blue"
            android:minHeight="30dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            tools:text="Subscribe" />

        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/close_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/subscribe_banner_bg"
            android:contentDescription="@string/close"
            android:src="@drawable/close_icon"
            android:visibility="gone" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>