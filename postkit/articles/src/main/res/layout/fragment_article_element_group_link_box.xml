<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    a:id="@+id/element_group_link_box_container"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:orientation="vertical"
    a:visibility="gone">

    <com.wapo.view.selection.SelectableTextView
        a:id="@+id/element_group_kicker"
        a:layout_width="wrap_content"
        a:layout_height="wrap_content"
        a:layout_gravity="left"
        a:paddingBottom="@dimen/native_article_headline_bottom_padding"
        a:text="Kicker"
        a:visibility="gone" />

    <com.wapo.view.selection.SelectableTextView
        a:id="@+id/element_group_title"
        a:layout_width="wrap_content"
        a:layout_height="wrap_content"
        a:layout_gravity="left"
        a:lineSpacingMultiplier="0.95"
        a:paddingBottom="@dimen/native_article_headline_bottom_padding"
        a:text="Headline"
        a:visibility="gone" />

    <com.wapo.view.selection.SelectableTextView
        a:id="@+id/element_group_subheadline"
        a:layout_width="wrap_content"
        a:layout_height="wrap_content"
        a:layout_gravity="left"
        a:paddingBottom="@dimen/native_article_byline_bottom_padding"
        a:text="subheadline"
        a:visibility="gone" />

    <com.wapo.view.selection.SelectableTextView
        a:id="@+id/element_group_dateline"
        a:layout_width="wrap_content"
        a:layout_height="wrap_content"
        a:layout_gravity="left"
        a:paddingBottom="@dimen/native_article_byline_bottom_padding"
        a:text="byline | DATE"
        a:visibility="gone" />

    <View
        a:id="@+id/top_rule"
        a:layout_width="match_parent"
        a:layout_height="1dp"
        a:layout_marginTop="@dimen/native_article_byline_bottom_padding"
        a:layout_marginBottom="@dimen/inline_container_padding_outer_top_bottom"
        a:background="@color/article_by_line_color"
        a:visibility="gone" />

    <FrameLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content">

        <LinearLayout
            a:id="@+id/element_group_items_container"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:orientation="vertical"
            a:visibility="gone" />

        <FrameLayout
            a:id="@+id/element_group_link_box_gradient_container"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_gravity="bottom"
            a:visibility="gone" />

    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        a:id="@+id/element_group_show"
        style="@style/MaterialTextButton"
        a:layout_width="wrap_content"
        a:layout_height="wrap_content"
        a:layout_gravity="center"
        a:drawablePadding="8dp"
        a:padding="8dp"
        a:visibility="gone" />

</LinearLayout>
