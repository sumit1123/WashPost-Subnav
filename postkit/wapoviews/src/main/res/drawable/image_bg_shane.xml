<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="@color/image_bg_shane_end_color"
                android:startColor="@color/image_bg_shane_start_color"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/app_bg" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <bitmap
            android:alpha="@dimen/async_shine_image_alpha"
            android:src="@drawable/async_shine" />
    </item>
</layer-list>
