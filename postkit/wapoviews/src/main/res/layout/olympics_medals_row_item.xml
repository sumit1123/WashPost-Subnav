<?xml version="1.0" encoding="utf-8"?>
<com.google.android.flexbox.FlexboxLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:focusableInTouchMode="true"
    android:layout_height="wrap_content"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingEnd="16dp"
    android:paddingStart="16dp"
    app:alignItems="center"
    app:flexWrap="nowrap">

    <TextView
        android:id="@+id/rank"
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:fontFamily="@font/franklin_itc_pro_light"
        android:gravity="start|center_vertical"
        android:minWidth="24dp"
        android:textColor="@color/olympics_table_text"
        android:textSize="14sp"
        app:layout_flexShrink="0"
        app:layout_minWidth="24dp" />

    <ImageView
        android:id="@+id/icon"
        android:contentDescription="@null"
        android:layout_width="24dp"
        android:layout_height="16dp"
        android:gravity="center"
        android:layout_marginEnd="8dp"
        android:scaleType="fitStart"
        app:layout_flexShrink="0"
        app:layout_minWidth="24dp" />

    <TextView
        android:id="@+id/country"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:fontFamily="@font/franklin_itc_pro_bold"
        android:gravity="center_vertical"
        android:textColor="@color/olympics_table_text_bold"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_flexShrink="1" />

    <TextView
        android:id="@+id/gold_medal_count"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:fontFamily="@font/franklin_itc_pro_light"
        android:gravity="center"
        android:textColor="@color/olympics_table_text"
        android:textSize="14sp"
        app:layout_minWidth="40dp" />

    <TextView
        android:id="@+id/silver_medal_count"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:fontFamily="@font/franklin_itc_pro_light"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/olympics_table_text"
        android:textSize="14sp"
        app:layout_minWidth="40dp" />

    <TextView
        android:id="@+id/bronze_medal_count"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:fontFamily="@font/franklin_itc_pro_light"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/olympics_table_text"
        android:textSize="14sp"
        app:layout_minWidth="40dp" />

    <TextView
        android:id="@+id/total_medal_count"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:fontFamily="@font/franklin_itc_pro_bold"
        android:gravity="center_vertical|end"
        android:singleLine="true"
        android:textColor="@color/olympics_table_text_bold"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_flexShrink="0" />

</com.google.android.flexbox.FlexboxLayout>