<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/label_text"
        style="@style/label_text_style"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/headline"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/image_container" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/headline"
        style="@style/headline_style"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/label_text"
        app:layout_constraintBottom_toTopOf="@id/secondary_text"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/image_container" />

    <com.wapo.view.ProportionalLayout
        android:id="@+id/image_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        app:aspectRatio="1.0"
        app:layout_constraintLeft_toRightOf="@id/headline"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.35">

        <com.washingtonpost.android.volley.toolbox.NetworkAnimatedImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true" />

    </com.wapo.view.ProportionalLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/secondary_text"
        style="@style/secondary_text_style"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="25dp"
        android:paddingStart="0dp"
        android:paddingEnd="25dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/image_container"
        app:layout_constraintTop_toBottomOf="@id/headline" />

</androidx.constraintlayout.widget.ConstraintLayout>