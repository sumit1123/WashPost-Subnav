<?xml version="1.0" encoding="utf-8"?>

<merge xmlns:a="http://schemas.android.com/apk/res/android">
    <!--a:layout_marginBottom="40dp"-->
    <TextView a:id="@+id/kicker" a:layout_width="wrap_content" a:layout_height="wrap_content"
        a:visibility="visible" />

    <!--a:layout_marginBottom="27dp"-->
    <TextView a:id="@+id/headline"
              a:layout_width="wrap_content" a:layout_height="wrap_content"
              a:visibility="gone"/>

    <TextView a:id="@+id/byline" a:layout_width="wrap_content" a:layout_height="wrap_content"
        a:visibility="visible" />

    <TextView a:id="@+id/time_and_blurb"
              a:layout_width="wrap_content" a:layout_height="wrap_content"
              a:visibility="gone"/>
</merge>