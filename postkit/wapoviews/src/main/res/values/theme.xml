<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <style name="PopupWindow">
        <item name="android:popupBackground">@color/transparent</item>
        <item name="android:background">@color/transparent</item>
    </style>

    <style name="Toolbar.Tabs" parent="Widget.Design.TabLayout">
        <item name="tab_view_layout">@layout/toolbar_tab</item>
        <item name="text_appearance">@style/Toolbar.Tab.TextAppearance</item>
        <item name="selected_text_appearance">@style/Toolbar.Tab.TextAppearance.Selected</item>
        <item name="tabIndicatorColor">@color/phone_tabs_accent</item>
        <item name="android:background">@color/action_bar_bg</item>
        <item name="android:elevation" tools:targetApi="lollipop">0dp</item>
        <item name="tabIndicatorAnimationDuration">0</item>
    </style>

    <style name="Toolbar.Tab" parent="">
        <item name="android:singleLine">true</item>
        <item name="android:textAllCaps">true</item>
        <item name="textAllCaps">false</item>
        <item name="android:gravity">top</item>
        <item name="android:textAppearance">@style/Toolbar.Tab.TextAppearance</item>
    </style>

    <style name="Toolbar.Tab.TextAppearance">
        <item name="fontFile">FranklinITCStd-Light.otf</item>
        <item name="android:textColor">@color/phone_tabs_text_secondary</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/phone_tabs_text_size</item>
    </style>

    <style name="Toolbar.Tab.TextAppearance.Selected">
        <item name="fontFile">FranklinITCStd-Bold.otf</item>
        <item name="android:textColor">@color/phone_tabs_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/phone_tabs_text_size</item>
    </style>

</resources>
