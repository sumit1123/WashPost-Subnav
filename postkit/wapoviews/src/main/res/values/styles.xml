<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="menu_ripple_color" format="color"/>

    <style name="ShareDialog" parent="android:Theme.Holo.Dialog">
        <item name="android:windowBackground">@drawable/color_transparent</item>
    </style>

    <style name="image_stream_kicker">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/sf_module_stream_headline_top_margin</item>
        <item name="android:textColor">@color/streamm_byline</item>
        <item name="android:textSize">@dimen/sf_module_stream_kicker_font_size</item>
        <item name="android:visibility">visible</item>
        <item name="android:fontFamily">?attr/image_stream_module_kicker_font</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="image_stream_headline">
        <item name="android:fontFamily">?attr/image_stream_module_headline_font</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="image_stream_byline">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/sf_module_stream_headline_top_margin</item>
        <item name="android:textColor">@color/streamm_byline</item>
        <item name="android:textSize">@dimen/sf_module_stream_byline_font_size</item>
        <item name="android:visibility">visible</item>
        <item name="android:fontFamily">?attr/image_stream_module_byline_font</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="image_stream_time_and_blurb">
        <item name="android:fontFamily">?attr/image_stream_module_time_and_blurb_font</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="stream_module_kicker">
        <item name="android:fontFamily">?attr/stream_module_kicker_font</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="stream_module_headline">
        <item name="android:fontFamily">?attr/stream_module_headline_font</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="stream_module_time_and_blurb" >
        <item name="android:fontFamily">?attr/stream_module_time_and_blurb_font</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="stream_module_byline">
        <item name="android:fontFamily">?attr/stream_module_byline_font</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="stream_module_last_updated">
        <item name="android:fontFamily">?attr/stream_module_last_updated_font</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Menu.Item" parent="">
        <item name="android:layout_height">@dimen/menu_item_height</item>
    </style>

    <style name="Menu.Item.Ripple">
        <item name="mrl_rippleColor">?attr/menu_ripple_color</item>
        <item name="mrl_rippleOverlay">true</item>
    </style>

    <style name="Menu.Text" parent="">
        <item name="android:fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="android:textStyle">normal</item>
        <item name="android:background">@color/sections_menu_bg</item>
        <item name="android:textColor">@color/menu_active_text</item>
        <item name="android:textSize">@dimen/menu_item_text_size</item>
    </style>

    <style name="Menu.Header.Text" parent="Menu.Text">
        <item name="android:fontFamily">@font/wp_postoniwide_font_family</item>
        <item name="fontFamily">@font/wp_postoniwide_font_family</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/menu_header_text_size</item>
    </style>

    <style name="Menu.Recent.Text" parent="TextAppearance.MaterialComponents.Chip">
        <item name="android:fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/menu_active_text</item>
        <item name="android:textSize">@dimen/menu_item_text_size</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Menu.Label.Text" parent="Menu.Text">
        <item name="android:fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/menu_inactive_title</item>
        <item name="android:textSize">@dimen/menu_label_text_size</item>
    </style>

    <style name="Menu.Divider" parent="">
        <item name="android:layout_height">@dimen/menu_item_divider_height</item>
        <item name="android:background">@color/menu_horizontal_ruler</item>
    </style>

    <style name="article_embedded_hide_photos" parent="article_embedded_show_more_photos">
        <item name="android:textColor">@color/show_more_photos_text_hide</item>
    </style>

    <style name="article_embedded_show_more_photos">
        <item name="android:textSize">@dimen/native_article_embedded_open_button_text_size</item>
        <item name="android:textColor">@color/show_more_photos_text_show</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFile">FranklinITCStd-Light.otf</item>
        <item name="fontFileBold">FranklinITCStd-Bold.otf</item>
        <item name="fontFileItalic">FranklinITCStd-LightItalic.otf</item>
        <item name="fontFileBoldItalic">FranklinITCStd-BoldItalic.otf</item>

    </style>

    <style name="saved_article_divider">
        <item name="android:visibility">gone</item>
    </style>

    <style name="SegmentedButtonNormal">
        <item name="android:fontFamily">@font/franklinitcstd_light</item>
        <item name="fontFamily">@font/franklinitcstd_light</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/live_image_segmented_tab_text</item>
    </style>

    <style name="SegmentedButtonSelected">
        <item name="android:fontFamily">@font/franklinitcstd_bold</item>
        <item name="fontFamily">@font/franklinitcstd_bold</item>
        <item name="android:textColor">@color/live_image_segmented_tab_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="secondary_button_style">
        <item name="fontFile">FranklinITCStd-Light.otf</item>
        <item name="fontFileBold">FranklinITCStd-Bold.otf</item>
        <item name="android:textColor">@color/secondary_action_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="label_text_style">
        <item name="android:textColor">@color/label_text_color</item>
        <item name="android:textSize">@dimen/label_text_size</item>
        <item name="android:lineSpacingExtra">@dimen/label_text_line_height</item>
        <item name="fontFamily">@font/franklinitcstd_light</item>
    </style>

    <style name="headline_style">
        <item name="android:textColor">@color/headline_text_color</item>
        <item name="android:textSize">@dimen/headline_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">@dimen/headline_line_height</item>
        <item name="fontFamily">@font/postoniwide_bold</item>
    </style>
    <style name="headline_prefix_style" parent="headline_style">
        <item name="android:textColor">@color/byline_opinion</item>
    </style>

    <style name="secondary_text_style">
        <item name="android:textColor">@color/secondary_text_color</item>
        <item name="android:lineSpacingExtra">@dimen/secondary_text_line_height</item>
        <item name="android:textSize">@dimen/secondary_text_size</item>
        <item name="fontFamily">@font/franklinitcstd_light</item>
    </style>

    <style name="secondary_text_highlight_style" parent="secondary_text_style">
        <item name="android:textColor">@color/secondary_text_highlight_color</item>
    </style>

    <style name="helper_text_style">
        <item name="fontFamily">@font/franklinitcstd_light</item>
        <item name="android:lineSpacingExtra">@dimen/helper_text_line_height</item>
        <item name="android:textColor">@color/helper_text_color</item>
        <item name="android:textSize">@dimen/helper_text_size</item>
    </style>

    <style name="MedalsTotalTextFull">
        <item name="android:fontFamily">@font/franklin_itc_pro_bold</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="MedalsTotalTextCompact">
        <item name="android:fontFamily">@font/franklin_itc_pro_light</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="slideshow_overlay_text" parent="">
        <item name="android:textColor">@color/slideshow_overlay_text</item>
        <item name="fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="android:fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">16.41sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="slideshow_caption_text">
        <item name="android:textColor">@color/slide_show_caption_text</item>
        <item name="android:fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">15sp</item>
    </style>

    <!-- Settings -->
    <style name="settings_category_style" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:background">@color/settings_category_bg</item>
        <item name="android:textColor">@color/settings_category_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="alert_category_style" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:background">@color/background_for_surfaces</item>
        <item name="fontFamily">@font/wp_franklinitcstd_font_family</item>
        <item name="android:textColor">@color/gray80</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="alert_preference_style" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/franklinitcstd_light</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/onSurface</item>
    </style>

    <style name="alert_description_style" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/franklinitcstd_light</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/onSurface_subtle</item>
    </style>

</resources>