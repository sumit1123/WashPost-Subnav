<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="custom_nav_cell">
        <item name="android:fontFamily">@font/franklinitcstd_bold</item>
        <item name="fontFamily">@font/franklinitcstd_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/custom_nav_cell_bg</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="custom_nav_cell_text">
        <item name="android:fontFamily">@font/franklinitcstd_bold</item>
        <item name="fontFamily">@font/franklinitcstd_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="custom_nav_reset_button">
        <item name="android:fontFamily">@font/franklinitcstd_bold</item>
        <item name="fontFamily">@font/franklinitcstd_bold</item>
        <item name="android:background">@drawable/custom_nav_reset_bg</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="custom_nav_subtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/franklinitcstd_light</item>
        <item name="android:textColor">@color/custom_nav_subtitle</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>