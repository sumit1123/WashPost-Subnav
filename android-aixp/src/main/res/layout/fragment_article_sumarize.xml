<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">

    <com.wapo.view.ShineFrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/article_summary_dialog_bg"
        app:shineHeight="250dp">

        <LinearLayout
            android:id="@+id/summary_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="56dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="48dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/headline"
                style="@style/ArticleText.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wp_postoniwide_font_family" />

            <TextView
                android:id="@+id/content_title"
                style="@style/ArticleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/wp_postoniwide_font_family"
                android:text="Summary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/content"
                style="@style/ArticleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/wp_georgia_font_family"
                android:textColorLink="@color/articles_main_text_color" />

            <TextView
                android:id="@+id/feedback_title"
                style="@style/ArticleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/wp_postoniwide_font_family"
                android:text="Feedback"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/ratings_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioGroup
                    android:id="@+id/radio_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </FrameLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_feedback_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColorHint="?attr/article_main_text_color"
                app:boxBackgroundColor="?attr/article_main_text_color"
                app:counterEnabled="true"
                app:counterTextColor="?attr/article_main_text_color"
                app:errorEnabled="true"
                app:errorTextColor="@color/error_text"
                app:helperText="Please enter the details of your feedback"
                app:helperTextTextColor="?attr/article_main_text_color"
                app:hintTextColor="?attr/article_main_text_color"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/description_header">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter Feedback"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:textColor="?attr/article_main_text_color"
                    android:textColorHint="?attr/article_main_text_color" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/submit_button"
                style="@style/zendesk_submit_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:text="@string/button_submit"
                android:textAllCaps="false"
                android:textColor="@color/zendesk_submit_text_color"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/disclaimer"
                style="@style/ArticleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/wp_georgia_font_family"
                android:textColorLink="@color/articles_main_text_color"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/error_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="250dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/error_message"
                style="@style/ArticleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/wp_georgia_font_family"
                android:gravity="center_horizontal"
                android:textSize="12sp" />

            <Button
                android:id="@+id/load_again_button"
                style="@style/zendesk_submit_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Retry"
                android:textAllCaps="false"
                android:textColor="@color/zendesk_submit_text_color"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:id="@+id/top_bar"
            android:layout_width="@dimen/dialog_top_bar_width"
            android:layout_height="@dimen/dialog_top_bar_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/dialog_top_bar" />

        <ProgressBar
            android:id="@+id/progress_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateOnly="true"
            android:progressBackgroundTint="@color/post_wp_blue_bright"
            android:visibility="gone" />
    </com.wapo.view.ShineFrameLayout>
</androidx.core.widget.NestedScrollView>