<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="tabletWidgetText">
        <item name="android:textColor">#2a2a2a</item>
        <item name="android:typeface">serif</item>
    </style>

    <style name="tabletWidgetTitle" parent="tabletWidgetText">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:typeface">sans</item>
    </style>

    <style name="tabletWidgetLabel" parent="tabletWidgetText">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="tabletWidgetHeadline" parent="tabletWidgetText">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="widgetTitle" parent="tabletWidgetText">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:typeface">sans</item>
    </style>

    <style name="widgetCounter" parent="tabletWidgetText">
        <item name="android:textSize">10sp</item>
        <item name="android:typeface">sans</item>
        <item name="android:textColor">#666666</item>
    </style>

    <style name="widgetHeadline" parent="tabletWidgetText">
        <item name="android:textSize">13dp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>