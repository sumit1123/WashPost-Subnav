<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools">

    <com.wapo.view.ProportionalLayout
        android:id="@+id/article_media_slot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/image_view"
            android:contentDescription="@string/article_image_description"
            android:layout_width="match_parent"
            android:adjustViewBounds="true"
            android:layout_height="match_parent"/>

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/placeholder"
            android:layout_width="match_parent"
            android:adjustViewBounds="true"
            android:layout_height="match_parent"/>

    </com.wapo.view.ProportionalLayout>

    <TextView
        android:id="@+id/article_media_caption"
        style="@style/ArticleText.ImageCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/articles_medium_margin"
        android:text="Image"
        android:paddingTop="@dimen/native_article_media_caption_top_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/article_media_slot" />

</androidx.constraintlayout.widget.ConstraintLayout>