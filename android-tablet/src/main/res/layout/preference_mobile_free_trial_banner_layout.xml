<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_banner"
        android:paddingTop="@dimen/subscribe_banner_padding_vertical"
        android:paddingBottom="@dimen/subscribe_banner_padding_vertical"
        android:paddingLeft="@dimen/subscribe_banner_padding_horizontal"
        android:paddingRight="@dimen/subscribe_banner_padding_horizontal"
        android:background="@color/pause_banner_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/primary_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            style="@style/PauseBannerMainText"
            tools:text="Your free preview ends soon."
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/secondary_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/subscribe_banner_margin"
            app:layout_constraintTop_toBottomOf="@id/primary_text"
            app:layout_constraintLeft_toLeftOf="parent"
            style="@style/PauseBannerSecondaryText"
            tools:text="Subscribe by February 28 to never miss a story."
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/chevron_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_chevronright16"
            app:tint="@color/settings_preference_right_arrow" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>