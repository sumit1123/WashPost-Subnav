<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/status_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="34dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_standalone_audio_play" />

    <ProgressBar
        android:id="@+id/status_progress_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/transparent"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/status_icon"
        app:layout_constraintEnd_toEndOf="@id/status_icon"
        app:layout_constraintStart_toStartOf="@id/status_icon"
        app:layout_constraintTop_toTopOf="@id/status_icon" />

    <TextView
        android:id="@+id/status_text"
        style="@style/standalone_audio_player_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/audio_carousel_item_listen"
        app:layout_constraintBottom_toBottomOf="@id/status_icon"
        app:layout_constraintStart_toEndOf="@id/status_icon"
        app:layout_constraintTop_toTopOf="@id/status_icon" />

    <TextView
        android:id="@+id/duration"
        style="@style/standalone_audio_player_status_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/audio_carousel_item_min"
        app:layout_constraintBottom_toBottomOf="@id/status_text"
        app:layout_constraintStart_toEndOf="@id/status_text"
        app:layout_constraintTop_toTopOf="@id/status_text" />

    <TextView
        android:id="@+id/caption"
        style="@style/standalone_audio_player_status_caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/status_icon" />
</androidx.constraintlayout.widget.ConstraintLayout>

