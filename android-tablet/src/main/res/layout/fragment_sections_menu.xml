<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    a:layout_width="match_parent"
    a:layout_height="match_parent"
    a:background="@color/sections_menu_bg"
    a:clickable="true"
    a:focusable="true"
    a:orientation="vertical">

    <FrameLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginLeft="@dimen/menu_bar_icons_left_margin"
        a:layout_marginTop="@dimen/menu_bar_icons_top_margin"
        a:layout_marginRight="@dimen/menu_bar_icons_left_margin"
        a:layout_marginBottom="@dimen/menu_bar_icons_top_margin">

        <ImageView
            a:id="@+id/iv_drawer_close_button"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:layout_gravity="start"
            a:src="@drawable/close_icon"
            a:contentDescription="@string/close"
            a:tint="@color/navigation_icon_tint" />

        <ImageView
            a:id="@+id/iv_drawer_wp_logo"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:layout_gravity="center"
            a:src="@drawable/twp_logo" />

        <ImageView
            a:id="@+id/iv_drawer_settings_button"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:layout_gravity="end"
            a:src="@drawable/settings_icon"
            a:contentDescription="@string/action_settings"
            a:tint="@color/navigation_icon_tint" />
    </FrameLayout>

    <include layout="@layout/menu_divider" />

    <com.wapo.view.menu.HierarchyMenuView
        a:id="@+id/sections_menu"
        style="@style/SectionsMenu"
        a:layout_width="match_parent"
        a:layout_height="wrap_content" />
</LinearLayout>