<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="start|bottom"
    android:background="@drawable/carousel_video_gradient_background_2">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controller_view_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="96dp"
        android:paddingStart="24dp"
        android:paddingTop="196dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/video_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:ellipsize="none"
            android:fontFamily="@font/wp_postoniwide_font_family"
            android:maxLines="5"
            android:textColor="#F7F7F7"
            android:textSize="24sp"
            app:fontFamily="@font/wp_postoniwide_font_family"
            app:layout_constraintBottom_toTopOf="@id/barrier1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="exo_play_pause" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@id/exo_play_pause"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginBottom="16dp"
            android:background="@drawable/color_transparent"
            android:padding="8dp"
            app:layout_constraintBottom_toTopOf="@id/barrier2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/ExoStyledControls.Button.Center.PlayPause" />
        
        <ImageButton
            android:id="@id/exo_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/color_transparent"
            android:padding="8dp"
            android:contentDescription="@string/ellipsis_menu_share_text"
            app:layout_constraintBottom_toTopOf="@id/barrier2"
            app:layout_constraintStart_toStartOf="parent"
            android:src="@drawable/ic_media_share" />

        <ImageButton
            android:id="@id/exo_cc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="60dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/color_transparent"
            android:padding="8dp"
            android:contentDescription="Closed captions"
            app:layout_constraintBottom_toTopOf="@id/barrier2"
            app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/ic_media_cc" />

        <ImageButton
            android:id="@id/exo_mute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/color_transparent"
            android:padding="10dp"
            android:contentDescription="Unmute"
            app:layout_constraintBottom_toTopOf="@id/barrier2"
            app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/ic_media_mute" />

        <ImageButton
            android:id="@id/exo_unmute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/color_transparent"
            android:padding="10dp"
            android:contentDescription="Mute"
            app:layout_constraintBottom_toTopOf="@id/barrier2"
            app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/ic_media_unmute" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="exo_progress" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/player_position_duration"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/player_position_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:importantForAccessibility="noHideDescendants"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wp_franklinitcstd_font_family"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@id/separator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wp_franklinitcstd_font_family"
                android:text=" / "
                android:textColor="#FFBEBEBE"
                android:textSize="14sp" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/wp_franklinitcstd_font_family"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>