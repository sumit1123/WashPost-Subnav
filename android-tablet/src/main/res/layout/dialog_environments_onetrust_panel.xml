<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="40dp"
    android:paddingRight="16dp"
    android:layout_margin="5dp">

    <CheckBox
        android:id="@+id/onetrust_stage_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Use OneTrust test environment"/>

    <LinearLayout
        android:id="@+id/onetrust_gpp_values"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/onetrust_gpp_string_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPP String"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/onetrust_gpp_string"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/onetrust_gpp_sid_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPP SID"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/onetrust_gpp_sid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
