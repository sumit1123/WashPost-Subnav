<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="248dp"
    android:layout_margin="@dimen/onboarding_medium_space"
    android:background="@drawable/content_packs_border">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_marginTop="@dimen/onboarding_medium_large_space"
        android:layout_marginLeft="3dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/onboarding_medium_large_space"
        android:layout_marginHorizontal="@dimen/onboarding_medium_space"
        android:ellipsize="end"
        android:maxLines="2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/image"
        style="@style/content_pack_title" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/onboarding_small_space"
        android:layout_marginHorizontal="@dimen/onboarding_medium_space"
        android:ellipsize="end"
        android:maxLines="3"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title"
        style="@style/content_pack_text" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/select_btn"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:layout_marginTop="@dimen/onboarding_medium_large_space"
        android:layout_marginBottom="@dimen/onboarding_large_space"
        android:layout_marginHorizontal="@dimen/onboarding_medium_large_space"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_max="135dp"
        android:state_selected="false"
        style="@style/content_pack_select_button"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            style="@style/content_pack_select_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:background="#0000"
            android:src="@drawable/content_packs_select_button_icon_selector" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/select_btn_text"
            style="@style/content_pack_select_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/onboarding_medium_space"
            android:clickable="false"
            android:background="#0000" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.constraintlayout.widget.ConstraintLayout>