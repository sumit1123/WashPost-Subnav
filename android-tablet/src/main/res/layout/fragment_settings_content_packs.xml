<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_content_packs"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/header"
        style="@style/settings_category_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/rv_settings_content_packs"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0"
        android:text="Customize Interests"
        android:paddingStart="?attr/listPreferredItemPaddingStart"
        android:paddingTop="20dip"
        android:paddingEnd="?attr/listPreferredItemPaddingEnd"
        android:paddingBottom="12dip"
        android:layout_marginBottom="@dimen/onboarding_medium_space" />

    <ProgressBar
        android:id="@+id/content_packs_spinner"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/content_packs_failure_header"
        android:visibility="gone"
        style="@style/content_packs_failure_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/content_packs_failure_header"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@+id/content_packs_failure_msg"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.33" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/content_packs_failure_msg"
        android:visibility="gone"
        style="@style/content_packs_failure_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/content_packs_failure_msg_onboarding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/content_packs_failure_header" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_settings_content_packs"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/onboarding_xlarge_space"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/my_post_recycler_view_bottom_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

</androidx.constraintlayout.widget.ConstraintLayout>