<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="44dp"
    android:background="@color/onboarding_bg">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:rotation="180"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_chevronright16" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/wp_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/wp_mark" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/wp_logo">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="120dp"
                app:layout_constraintTop_toBottomOf="@id/secondary_title">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/step_count"
                    style="@style/onboarding_step_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/onboarding_medium_large_space"
                    android:text="step 1 of 3" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/primary_title"
                    style="@style/onboarding_primary_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:layout_marginTop="@dimen/onboarding_small_space"
                    android:text="@string/audio_main_title" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/secondary_title"
                    style="@style/onboarding_secondary_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/onboarding_medium_space"
                    android:text="@string/audio_secondary_title" />

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/fragment_container_view"
                    android:name="com.wapo.flagship.features.settings.SettingsAudioFragment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/onboarding_medium_large_space"
                    android:tag="settings_audio_fragment" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/onboarding_bg"
        android:orientation="vertical"
        android:paddingBottom="@dimen/onboarding_medium_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@color/divider_color" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/continue_btn"
            style="@style/primary_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintWidth_max="312dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider"
            android:layout_marginStart="@dimen/onboarding_xlarge_space"
            android:layout_marginTop="@dimen/onboarding_medium_large_space"
            android:layout_marginEnd="@dimen/onboarding_xlarge_space"
            android:text="@string/onboarding_continue_btn_text" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>