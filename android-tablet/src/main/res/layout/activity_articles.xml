<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:background="@color/behind_articles_cards_bg"
    tools:context="com.wapo.flagship.features.articles2.activities.Articles2Activity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        app:layout_behavior="com.wapo.view.design.widget.AppBarBehavior"
        >

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|enterAlways"
            app:navigationIcon="?attr/app_bar_nav_arrow_icon"
            android:theme="@style/BaseWaPo.Phone.Toolbar.Articles"
            />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/compose_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|enterAlways"
            />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/banner_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|enterAlways"
            />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:navGraph="@navigation/nav_articles"/>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/new_updates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Update"
        app:backgroundTint="@color/kicker_pill_live_bg_color"
        android:textColor="#FFFFFF"
        android:outlineSpotShadowColor="#003F51B5"
        android:textAllCaps="false"
        android:visibility="gone"
        app:layout_behavior="com.wapo.flagship.features.articles2.views.MoveUpForPersistentPlayerBehavior"
        android:layout_gravity="bottom|center"
        android:layout_marginBottom="60dp" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/map_wall_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="60dp"
        android:visibility="gone"
        app:layout_behavior="com.wapo.flagship.features.articles2.views.MoveUpForPersistentPlayerBehavior"/>


    <FrameLayout
        android:id="@+id/persistent_player_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:visibility="gone"
        android:background="@color/tile_card_background"
        app:layout_behavior="com.wapo.flagship.views.MoveUpForSnackbarBehavior" />

    <com.washingtonpost.android.paywall.bottomsheet.ui.BottomCtaView
        android:id="@+id/bottom_sheet_cta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:behavior_hideable="true"
        app:behavior_peekHeight="@dimen/bottom_sheet_height"
        app:layout_behavior="com.washingtonpost.android.paywall.bottomsheet.PaywallSheetBehavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>