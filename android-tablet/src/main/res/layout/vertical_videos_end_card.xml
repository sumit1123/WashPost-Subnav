<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/carousel_video_gradient_background_1">

    <TextView
        android:id="@+id/end_of_videos_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/vertical_videos_end_of_videos"
        android:textAppearance="@style/vertical_videos_end_of_videos"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.24" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/return_button"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="24dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/vertical_videos_return_to_top_stories"
        android:textAppearance="@style/vertical_videos_return_to_top_stories"
        app:layout_constraintTop_toBottomOf="@id/end_of_videos_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/vertical_videos_return_button_outline" />

</androidx.constraintlayout.widget.ConstraintLayout>