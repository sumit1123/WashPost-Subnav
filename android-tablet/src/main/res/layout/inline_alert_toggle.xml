<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <View
        android:id="@+id/top_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/inline_alert_toggle_divider_height"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@color/inline_alert_toggle_divider"/>

    <TextView
        android:id="@+id/toggle_disabled_text"
        style="@style/inline_alert_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/inline_alert_toggle_content_vertical_margin"
        android:layout_marginBottom="@dimen/inline_alert_toggle_content_vertical_margin"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_divider"
        app:layout_constraintBottom_toTopOf="@id/bottom_divider"/>

    <TextView
        android:id="@+id/toggle_enabled_text"
        android:visibility="gone"
        style="@style/inline_alert_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/inline_alert_toggle_content_vertical_margin"
        android:layout_marginBottom="@dimen/inline_alert_toggle_content_vertical_margin"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_divider"
        app:layout_constraintBottom_toTopOf="@id/bottom_divider"/>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/toggle_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/inline_alert_toggle_content_vertical_margin"
        android:layout_marginBottom="@dimen/inline_alert_toggle_content_vertical_margin"
        android:checked="false"
        android:background="@null"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_divider"
        app:layout_constraintBottom_toTopOf="@id/bottom_divider" />

    <View
        android:id="@+id/bottom_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/inline_alert_toggle_divider_height"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/inline_alert_toggle_divider"/>

</androidx.constraintlayout.widget.ConstraintLayout>