<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="10dp">

    <Button
        android:id="@+id/pref_sign_out"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/sign_out_button_height"
        android:layout_gravity="center"
        android:background="@drawable/settings_pill_background"
        android:fontFamily="@font/wp_franklinitcstd_font_family"
        android:minWidth="110dp"
        android:text="@string/sign_out"
        android:textAllCaps="false"
        android:textColor="@color/settings_sign_out"
        android:textSize="16sp"
        android:textStyle="bold" />
</FrameLayout>
