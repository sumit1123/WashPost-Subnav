<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:a="http://schemas.android.com/apk/res/android"
    a:layout_width="match_parent"
    a:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    a:background="@color/print_edition_background"
    a:id="@+id/pdf_reader_main_layout"
    a:animateLayoutChanges="true">

    <androidx.appcompat.widget.Toolbar
        a:id="@+id/toolbar"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:theme="?attr/app_bar_day_night_style">
        <RelativeLayout a:layout_height="wrap_content" a:layout_width="match_parent" a:paddingEnd="12dp">
             <TextView xmlns:android="http://schemas.android.com/apk/res/android"
                android:id="@+id/page_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.AppCompat.ActionBar.TabText"
                android:textAllCaps="true"
                android:layout_alignParentEnd="true"
                android:drawablePadding="8dp"
                android:clickable="true" />
        </RelativeLayout>

    </androidx.appcompat.widget.Toolbar>

    <RelativeLayout
        a:layout_width="match_parent"
        a:layout_height="match_parent"
        a:layout_below="@id/toolbar">

        <com.radaee.view.WapoPDFViewPager
            a:id="@+id/pdf_pager"
            a:layout_width="match_parent"
            a:layout_height="match_parent"/>

        <ImageView
            a:id="@+id/thumbView"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_alignParentLeft="true"
            a:layout_alignParentRight="true"
            a:adjustViewBounds="true"
            a:layout_centerInParent="true"
            a:scaleType="matrix"
            a:contentDescription="@null" />

        <!-- a:layout_alignParentBottom="true" -->

        <ProgressBar
            style="?android:attr/progressBarStyleLargeInverse"
            a:id="@+id/pdf_indicator"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:layout_centerInParent="true"/>
        <FrameLayout
            a:layout_width="match_parent"
            a:layout_height="@dimen/print_download_bar_height">
            <ProgressBar a:id="@+id/download_progress"
                a:layout_gravity="center"
                style="?android:attr/progressBarStyleHorizontal"
                a:max="100"
                a:indeterminate="false"
                a:layout_marginTop="@dimen/print_download_bar_margin"
                a:visibility="invisible"
                a:layout_height="wrap_content"
                a:layout_width="match_parent" />
        </FrameLayout>
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView a:id="@+id/pdf_thumbnails"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_below="@id/toolbar"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        a:background="@color/print_edition_thumbnails_background"
        a:orientation="horizontal"
        a:visibility="gone" />

</RelativeLayout>