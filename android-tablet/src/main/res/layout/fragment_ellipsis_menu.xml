<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/my_post_dialog_bg"
    android:paddingBottom="32dp">

    <View
        android:id="@+id/view_top_bar"
        android:layout_width="48dp"
        android:layout_height="@dimen/dialog_top_bar_height"
        android:layout_marginTop="@dimen/podcast_vertical_margin_medium"
        android:background="@drawable/dialog_top_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/selection_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/view_top_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_gift"
                style="@style/MyPost.Utility.Menu.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_gift"
                android:text="@string/ellipsis_menu_gift_text"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_add_to_saved_stories"
                style="@style/MyPost.Utility.Menu.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_ab_article_save"
                android:text="@string/ellipsis_menu_save_text"
                app:layout_constraintTop_toBottomOf="@id/button_gift" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_share"
                style="@style/MyPost.Utility.Menu.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/icon_share"
                android:text="@string/ellipsis_menu_share_text"
                app:layout_constraintTop_toBottomOf="@id/button_add_to_saved_stories" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_listen"
                style="@style/MyPost.Utility.Menu.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_listen"
                android:text="@string/listen"
                app:layout_constraintTop_toBottomOf="@id/button_share" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_add_to_playlist"
                style="@style/MyPost.Utility.Menu.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_playlist"
                android:text="@string/ellipsis_menu_add_playlist"
                app:layout_constraintTop_toBottomOf="@id/button_listen" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_read_article"
                style="@style/MyPost.Utility.Menu.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_article_read"
                android:text="@string/ellipsis_menu_read_text"
                app:layout_constraintTop_toBottomOf="@+id/button_add_to_playlist" />


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_remove_from_saved_stories"
                style="@style/MyPost.Utility.Menu.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_trash"
                android:text="Remove from saved stories"
                app:layout_constraintTop_toBottomOf="@id/button_read_article" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_remove_from_playlist"
                style="@style/MyPost.Utility.Menu.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_clear"
                android:text="@string/ellipsis_remove_playlist"
                app:layout_constraintTop_toBottomOf="@id/button_remove_from_saved_stories" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/confirmation_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/view_top_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_remove_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_confirm_remove" />

        <TextView
            android:id="@+id/tv_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/wp_postoniwide_font_family"
            android:gravity="center"
            android:text="Remove from saved stories?"
            android:textColor="@color/my_post_dialog_label"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_remove_icon" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tv_label">

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/buttons_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="left"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="parent" />

            <com.google.android.material.chip.Chip
                android:id="@+id/button_cancel"
                style="@style/MyPost.Action.Chip.Light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:text="Cancel"
                android:textAppearance="@style/MyPost.Action.Chip.Light.Text"
                app:layout_constraintEnd_toStartOf="@id/buttons_barrier" />

            <com.google.android.material.chip.Chip
                android:id="@+id/button_confirm"
                style="@style/MyPost.Action.Chip.Dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Confirm"
                android:textAppearance="@style/MyPost.Action.Chip.Dark.Text"
                app:layout_constraintStart_toEndOf="@id/buttons_barrier" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/view_margin"
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:layout_marginTop="36dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_buttons" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>