<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/top_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/article_pull_quote_rule_line_color"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.wapo.view.selection.SelectableTextView
        android:id="@+id/pull_quote_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/native_article_pullquote_rule_inner_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_rule" />

    <com.wapo.view.selection.SelectableTextView
        android:id="@+id/pull_quote_caption_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/native_article_pullquote_rule_inner_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pull_quote_text" />

    <View
        android:id="@+id/bottom_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/pull_quote_caption_text"
        android:layout_marginTop="@dimen/native_article_pullquote_rule_inner_margin"
        android:background="@color/article_pull_quote_rule_line_color"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pull_quote_caption_text" />

</androidx.constraintlayout.widget.ConstraintLayout>