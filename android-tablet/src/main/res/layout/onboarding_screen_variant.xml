<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:orientation="vertical">

    <View
        a:layout_width="0dp"
        a:layout_height="0dp"
        a:layout_weight="2" />

    <TextView
        a:id="@+id/onboarding_heading"
        style="@style/onboarding_screen_header_style_variant"
        a:layout_width="wrap_content"
        a:layout_height="wrap_content"
        a:minWidth="@dimen/onboarding_text_variant_minmax_width"
        a:maxWidth="@dimen/onboarding_text_variant_minmax_width"/>
    <TextView
        a:id="@+id/onboarding_description"
        style="@style/onboarding_screen_description_style_variant"
        a:layout_width="wrap_content"
        a:layout_height="wrap_content"
        a:minWidth="@dimen/onboarding_text_description_variant_minmax_width"
        a:maxWidth="@dimen/onboarding_text_description_variant_minmax_width"/>

</LinearLayout>