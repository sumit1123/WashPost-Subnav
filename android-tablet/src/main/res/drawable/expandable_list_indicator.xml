<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_expanded="true">
        <layer-list>
            <item
                android:width="16dp"
                android:height="16dp"
                android:gravity="center_vertical">
                <rotate
                    android:drawable="@drawable/ic_chevronright16"
                    android:fromDegrees="90"
                    android:toDegrees="90"
                    android:pivotX="50%"
                    android:pivotY="50%" />
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:width="16dp"
                android:height="16dp"
                android:gravity="center_vertical">
                <rotate
                    android:drawable="@drawable/ic_chevronright16"
                    android:fromDegrees="0"
                    android:toDegrees="0"
                    android:pivotX="50%"
                    android:pivotY="50%" />
            </item>
        </layer-list>
    </item>
</selector>


