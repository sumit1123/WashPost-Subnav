<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="sf_module_panel_layout" parent="sf_module_panel">
    </style>

    <style name="left_menu_textview">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/slider_menu_item_min_height</item>
        <item name="android:textColor">@color/menu_text</item>
        <item name="android:textSize">@dimen/left_menu_text_size</item>
        <item name="android:typeface">normal</item>
    </style>

    <style name="expandable_menu_divider">
        <item name="android:divider">@color/dark_gray</item>
    </style>

    <style name="LeftMenu">
        <item name="android:layout_width">400dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_gravity">start</item>
    </style>

    <style name="widgetHeadlineText" parent="widgetHeadline">
        <item name="android:maxLines">5</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>