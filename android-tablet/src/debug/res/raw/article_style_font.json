      "content_elements": [
        {
          "type": "sanitized_html",
          "subtype": "paragraph",
          "mime": "text/html",
          "content": "Well+Being shares news and advice for living well every day. <a href=\"https://www.washingtonpost.com/newsletters/well-being/\">Sign up for our newsletter to get tips directly in your inbox.</a>"
        },
        {
          "type": "sanitized_html",
          "subtype": "paragraph",
          "mime": "text/html",
          "content": "<a href=\"https://www.washingtonpost.com/wellness/interactive/2023/birds-song-nature-mental-health-benefits/?itid=ap_richardsima\">Birds and their songs</a> are good for our mental health."
        },
        {
          "type": "sanitized_html",
          "subtype": "paragraph",
          "mime": "text/html",
          "content": "Avoid these four mistakes <a href=\"https://www.washingtonpost.com/wellness/2023/05/05/loneliness-social-isolation/\">when you’re lonely</a>."
        },
        {
          "type": "sanitized_html",
          "subtype": "paragraph",
          "mime": "text/html",
          "content": "Should you stop using <a href=\"https://www.washingtonpost.com/wellness/2023/05/16/sugar-substitutes-artificial-sweeteners-health/\">sugar substitutes</a>?"
        },
        {
          "type": "sanitized_html",
          "subtype": "paragraph",
          "mime": "text/html",
          "content": "Older athletes share tips on <a href=\"https://www.washingtonpost.com/wellness/2023/05/19/stay-fit-aging-exercise/\">exercising as you age</a>."
        },
        {
          "type": "sanitized_html",
          "subtype": "paragraph",
          "mime": "text/html",
          "content": "<a href=\"https://www.washingtonpost.com/wellness/2023/05/08/fake-sign-language-asl-tiktok/\">Fake sign language on TikTok</a> has deaf people worried."
