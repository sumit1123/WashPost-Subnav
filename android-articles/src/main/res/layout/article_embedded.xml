<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_embedded_shadow"
        android:orientation="vertical">

        <TextView
            android:id="@+id/backstory_label"
            style="@style/backstory_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:text="@string/backstory_label"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/headline_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="5dp"
            android:paddingRight="5dp">

            <TextView
                android:id="@+id/tv_embedded_headline"
                style="@style/article_embedded_text_headline_span"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_weight="0.6"
                android:text="New Text" />

            <com.wapo.view.ProportionalLayout
                android:id="@+id/pl_article_embedded_media_slot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.4">

                <com.washingtonpost.android.volley.toolbox.NetworkAnimatedImageView
                    android:id="@+id/iv_article_embedded"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true" />
            </com.wapo.view.ProportionalLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tv_embedded_blurb_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="5dp"
            android:paddingTop="5dp"
            android:paddingRight="5dp">

            <TextView
                android:id="@+id/tv_embedded_byline"
                style="@style/article_embedded_text_byline_span"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Text"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_embedded_blurb"
                style="@style/article_embedded_text_deck_span"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Text"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:id="@+id/top_rule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/article_embedded_by_line_color"
            android:visibility="visible" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <Button
                android:id="@+id/b_embedded_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginRight="15dp"
                android:background="@drawable/subscribe_button_background_img"
                android:gravity="center"
                android:paddingLeft="@dimen/article_embedded_read_button_padding_horizontal"
                android:paddingTop="@dimen/article_embedded_read_button_padding_vertical"
                android:paddingRight="@dimen/article_embedded_read_button_padding_horizontal"
                android:paddingBottom="@dimen/article_embedded_read_button_padding_vertical"
                android:text="@string/label_open"
                android:textAppearance="@style/article_embedded_open_button"
                android:visibility="visible" />

            <TextView
                android:id="@+id/b_embedded_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/b_embedded_read"
                android:layout_gravity="end"
                android:layout_marginStart="15dp"
                android:layout_marginLeft="15dp"
                android:layout_toRightOf="@id/b_embedded_read"
                android:drawableRight="@drawable/ic_share_selector"
                android:gravity="right"
                android:textAppearance="@style/article_embedded_open_button"
                android:visibility="visible" />

        </RelativeLayout>
    </LinearLayout>
</FrameLayout>